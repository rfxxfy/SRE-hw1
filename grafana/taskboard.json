      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "SLA: успешные проверки за 24 ч",
      "type": "stat",
      "description": "Доля успешных проверок за последние 24 часа. Целевой SLO — 99,9%.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(increase(taskboard_probe_checks_total{app=\"taskboard-probe\",result=\"success\"}[24h])) / clamp_min(sum(increase(taskboard_probe_checks_total{app=\"taskboard-probe\"}[24h])), 1)",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "RPS API",
      "type": "timeseries",
      "description": "Нагрузка на API задач без служебных health-запросов.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(flask_http_request_duration_seconds_count{app=\"taskboard-web\",url_rule=~\"/api/tasks.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Ошибки API, %",
      "type": "timeseries",
      "description": "Доля ответов 5xx среди запросов к API.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (sum(rate(flask_http_request_duration_seconds_count{app=\"taskboard-web\",url_rule=~\"/api/tasks.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(flask_http_request_duration_seconds_count{app=\"taskboard-web\",url_rule=~\"/api/tasks.*\"}[$__rate_interval])), 0.001)",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Задержка API p95",
      "type": "timeseries",
      "description": "95-й процентиль времени ответа API.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{app=\"taskboard-web\",url_rule=~\"/api/tasks.*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{pod}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
